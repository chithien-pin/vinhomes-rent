# Supabase → Connect / Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Key mới (publishable) — ưu tiên
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Hoặc key cũ (anon JWT) — vẫn hỗ trợ
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase → Connect → ORMs → Prisma (copy nguyên chuỗi)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
