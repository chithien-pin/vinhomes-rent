# Vercel Storage → Prisma Postgres (hoặc Postgres Neon)
# Map từ STORAGE_PRISMA_DATABASE_URL / POSTGRES_PRISMA_URL
DATABASE_URL="postgres://...@db.prisma.io:5432/postgres?sslmode=require"
# Cùng URL nếu không có non-pooling riêng
DIRECT_URL="postgres://...@db.prisma.io:5432/postgres?sslmode=require"

# Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
